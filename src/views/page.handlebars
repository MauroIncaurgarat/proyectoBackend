<h1>{{pageTitle}}</h1>
<h2>Pagina actual {{products.page}}</h2>
{{#if err}}
<div>Error: No Existe la pagina ingresada. Se redirige a pagina 1</div>
{{/if}}
<div class="conteiner"> 
    {{#each products.docs}}
        <ul id="{{id}}">
            <li>Producto: {{title}}
                <ul>
                    <li>Description: {{description}}</li>
                    <li>Precio: {{price}}</li>
                    <li>Stock: {{stock}}</li>
                </ul>
            </li>
        </ul>
    {{/each}}
</div>
{{#if products.hasPrevPage }}
<a href="/api/product?page={{products.prevPage}}">Anterior</a>
{{/if}}
{{#if products.hasNextPage }}
<a href="/api/product?page={{products.nextPage}}">Siguiente</a>
{{/if}}